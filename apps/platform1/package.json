{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite",
    "start": "cross-env NODE_OPTIONS=--no-deprecation vite",
    "start:studio": "cross-env NODE_OPTIONS=--no-deprecation vite --mode studio",
    "build": "cross-env REACT_APP_BUILD_TIME=$(date \"+%s\") vite build",
    "lint": "eslint src --ext js,jsx,ts,tsx --fix --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,less}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,less}\""
  },

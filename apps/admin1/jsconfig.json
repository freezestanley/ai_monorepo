{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "checkJs": false,
    "allowUmdGlobalAccess": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "lib": ["ES2015", "dom"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
